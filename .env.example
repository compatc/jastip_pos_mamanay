VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# BOQris (untuk server / api, jangan pakai prefix VITE_)
BOQRIS_API_KEY=your-boqris-api-key
BOQRIS_MERCHANT_ID=your-merchant-uuid
BOQRIS_BASE_URL=https://api.boqris.id
BOQRIS_DEV_PORT=8788
# Maksimal kode unik yang dikurangkan dari total (rp). Transaksi dicoba dari kode 1 ke atas
BOQRIS_UNIQUE_MAX=200
# Secret webhook BOQris (dibuat di Dashboard BOQris -> Integrasi -> Webhook).
# URL webhook arahkan ke: https://<domain>/api/pay
BOQRIS_WEBHOOK_SECRET=your-whsec-value

# Login admin Supabase (server / api, bukan VITE_)
SUPABASE_EMAIL=your-admin-email
SUPABASE_PASSWORD=your-admin-password
# Fallback untuk VITE_* (opsional, dipakai serverless)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Web Push (notifikasi di handphone walau app tertutup)
# Kunci publik ini BOLEH tampil di frontend (VITE_). Generate sekali: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com
