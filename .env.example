VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# BOQris (untuk server / api, jangan pakai prefix VITE_)
BOQRIS_API_KEY=your-boqris-api-key
BOQRIS_MERCHANT_ID=your-merchant-uuid
BOQRIS_BASE_URL=https://api.boqris.id
BOQRIS_DEV_PORT=8788
# Kode unik maksimal yang dikurangi dari nominal (default 200). 1 = tanpa kode unik.
# Nominal QRIS = tagihan - kode unik (pembulatan ke bawah, maksimal Rp200).
BOQRIS_UNIQUE_MAX=200
# Secret webhook BOQris (dibuat di Dashboard BOQris -> Integrasi -> Webhook).
# URL webhook arahkan ke: https://<domain>/api/pay
BOQRIS_WEBHOOK_SECRET=your-whsec-value

# Login admin Supabase (server / api, bukan VITE_)
SUPABASE_EMAIL=your-admin-email
SUPABASE_PASSWORD=your-admin-password
# Fallback untuk VITE_* (opsional, dipakai serverless)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
